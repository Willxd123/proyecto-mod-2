server {
    listen 443 ssl;
    server_name {{ frontend_server_name }};

    ssl_certificate /etc/campus-cloud/tls/{{ tenant_slug }}/fullchain.pem;
    ssl_certificate_key /etc/campus-cloud/tls/{{ tenant_slug }}/privkey.pem;

    root /var/www/campus-cloud/{{ tenant_slug }}/current;
    index index.html;
    client_max_body_size 11m;

    location /api/ {
        proxy_pass http://{{ backend_private_ip }}:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
