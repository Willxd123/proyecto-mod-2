server {
    listen 80;
    server_name {{ frontend_server_name }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/campus-cloud/{{ tenant_slug }}/acme;
    }

    location / {
{% if frontend_tls_ready | bool %}
        return 301 https://{{ frontend_server_name }}$request_uri;
{% else %}
        return 503;
{% endif %}
    }
}
{% if frontend_tls_ready | bool %}

server {
    listen 443 ssl;
    server_name {{ frontend_server_name }};
    ssl_certificate /etc/letsencrypt/live/campus-cloud-{{ tenant_slug }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/campus-cloud-{{ tenant_slug }}/privkey.pem;
    root /var/www/campus-cloud/{{ tenant_slug }}/current;
    index index.html;
    client_max_body_size 11m;

    location /api/ {
        proxy_pass http://{{ backend_private_ip }}:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
{% endif %}
