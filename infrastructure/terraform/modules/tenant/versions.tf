# Módulo compartido por las raíces infrastructure/terraform y infrastructure/opentofu.
# No declara backend ni proveedor: los configura cada raíz.
terraform {
  required_version = ">= 1.7.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}
