HOST=127.0.0.1
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=proyecto_modulo_2
DATABASE_SSL=false
# Opcional: ruta absoluta al manifiesto de AMIs reales.
GOLDEN_IMAGES_PATH=
# Solo para una demostración local confiable; no autentica al operador.
ARTIFACT_PREPARATION_LOCAL=false
# Escaneo optativo solo desde el panel local; no autentica al operador.
SECURITY_SCAN_LOCAL=false
# Flujo completo de demostración local; no autentica al operador. Mantener false fuera de pruebas controladas.
DEMO_PROVISIONING_LOCAL=false
# Para probar la demo: cuenta compartida autorizada, IP pública del operador /32,
# clave SSH protegida y accesible desde WSL, correo válido para Certbot.
AWS_EXPECTED_ACCOUNT_ID=
DEMO_SSH_CIDR=
DEMO_SSH_PRIVATE_KEY_WSL_PATH=
SSH_KEY_PAIR_NAME=practico7-asistencia
DEMO_CERTBOT_EMAIL=
# Ruta local WSL al paquete python3-psycopg2 para Ubuntu 24.04, fuera de Git.
DEMO_POSTGRESQL_PSYCOPG_DEB=
# Identificador de 32 caracteres que devuelve «Comprobar paquetes».
DEMO_ARTIFACT_RELEASE=
DEMO_ADMIN_NAME=Administrador de la institucion

# Acceso del administrador de la plataforma (un único usuario). Sin ADMIN_PASSWORD el panel local queda abierto.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Opcional: secreto para firmar sesiones; si falta se genera uno nuevo en cada arranque.
AUTH_SECRET=
# Solo para probar el ciclo de vida sin AWS: marca todo como [SIMULADO] y no toca la nube. Mantener false en demostraciones reales.
LIFECYCLE_SIMULATE=false

# Distribución de WSL con Ansible (por ejemplo Ubuntu). Obligatoria si la predeterminada es otra, como docker-desktop.
WSL_DISTRO=Ubuntu

# Intérprete de Python con pulumi y pulumi-aws para habilitar Pulumi en el panel (o cree infrastructure/pulumi/.venv).
# PULUMI_PYTHON=C:/ruta/a/python.exe
