[Unit]
Description=Control de asistencia backend - {{ tenant_slug }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campus-cloud
Group=campus-cloud
WorkingDirectory=/opt/campus-cloud/{{ tenant_slug }}/backend/current
EnvironmentFile=/etc/campus-cloud/{{ tenant_slug }}/backend.env
EnvironmentFile=/etc/campus-cloud/{{ tenant_slug }}/backend-secrets.env
ExecStart=/opt/campus-cloud/{{ tenant_slug }}/backend/venv/bin/gunicorn --bind 0.0.0.0:{{ backend_port }} --workers 2 config.wsgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
