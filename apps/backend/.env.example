HOST=127.0.0.1
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=proyecto_modulo_2
DATABASE_SSL=false
# Opcional: ruta absoluta al manifiesto de AMIs reales.
GOLDEN_IMAGES_PATH=

# ── Observabilidad (RF-25 a RF-29) ──────────────────────────────────────────
# IP pública del servidor de observabilidad (output de Terraform).
# Si no se define, la UI muestra "sin servidor configurado".
OBS_SERVER_IP=
# Credenciales de Grafana (solo se expone el usuario al frontend, nunca la contraseña).
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
# Token secreto que Alertmanager debe enviar en la cabecera x-webhook-token.
WEBHOOK_TOKEN=
