{
  "uid": "tenant-health",
  "title": "Salud por tenant",
  "tags": [
    "tenant-control-center"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "description": "RF-25 a RF-27: disponibilidad, CPU, memoria, disco, latencia, errores y PostgreSQL por tenant y entorno.",
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{scope=\"tenant\"}, tenant)",
          "refId": "tenant"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{scope=\"tenant\", tenant=~\"$tenant\"}, environment)",
          "refId": "environment"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad de los servidores (RF-26)",
      "type": "stat",
      "description": "Cada servidor del tenant responde a su node_exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ARRIBA",
                  "color": "green"
                },
                "0": {
                  "text": "CAÍDO",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", job=\"tenant-nodes\"}",
          "legendFormat": "{{tenant}} · {{role}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Aplicación de asistencia (HTTPS)",
      "type": "stat",
      "description": "La API del tenant responde 200 en /api/health.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ARRIBA",
                  "color": "green"
                },
                "0": {
                  "text": "CAÍDO",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", job=\"tenant-http\"}",
          "legendFormat": "{{tenant}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "title": "Estado de PostgreSQL",
      "type": "stat",
      "description": "El servicio PostgreSQL del tenant acepta conexiones (postgres_exporter).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ARRIBA",
                  "color": "green"
                },
                "0": {
                  "text": "CAÍDO",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_up{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", job=\"tenant-postgres\"}",
          "legendFormat": "{{tenant}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "Uso de CPU (%)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - (avg by (tenant, role) (rate(node_cpu_seconds_total{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "{{tenant}} · {{role}}",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Uso de memoria (%)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\"} / node_memory_MemTotal_bytes{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\"})",
          "legendFormat": "{{tenant}} · {{role}}",
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Uso de disco (%) — volumen raíz",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", mountpoint=\"/\", fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{tenant}} · {{role}}",
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Latencia de la API (ms)",
      "type": "timeseries",
      "description": "Tiempo de respuesta de /api/health medido desde Prometheus.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_duration_seconds{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", job=\"tenant-http\"} * 1000",
          "legendFormat": "{{tenant}}",
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Errores de la API: fallos en los últimos 5 min (%)",
      "type": "timeseries",
      "description": "Porcentaje de sondas fallidas y el último código HTTP devuelto (5xx = error del backend).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg_over_time(probe_success{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", job=\"tenant-http\"}[5m]))",
          "legendFormat": "{{tenant}} fallos",
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_http_status_code{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", job=\"tenant-http\"}",
          "legendFormat": "{{tenant}} código HTTP",
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "title": "Conexiones activas a PostgreSQL",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tenant) (pg_stat_database_numbackends{scope=\"tenant\", tenant=~\"$tenant\", environment=~\"$environment\", datname=\"control_asistencia\"})",
          "legendFormat": "{{tenant}}",
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "title": "Alertas activas",
      "type": "alertlist",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "options": {
        "alertInstanceLabelFilter": "{tenant=~\"$tenant\"}",
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        },
        "viewMode": "list"
      }
    }
  ]
}
