# Copie este archivo a infrastructure/observability/.env (Git lo ignora) y complete los valores.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3002
# Mismo valor que WEBHOOK_TOKEN en apps/backend/.env: con él Grafana entrega las alertas al panel.
WEBHOOK_TOKEN=
# Dirección del panel vista desde el contenedor de Grafana.
CONTROL_CENTER_URL=http://host.docker.internal:3000
# Opcional: fijar otras versiones de las imágenes.
# PROMETHEUS_IMAGE=prom/prometheus:latest
# GRAFANA_IMAGE=grafana/grafana-oss:latest
# BLACKBOX_IMAGE=prom/blackbox-exporter:latest
